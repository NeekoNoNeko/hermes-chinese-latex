{
  "name": "hermes-chinese-latex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hermes Desktop 中文行内公式显示修复",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeekoNoNeko/hermes-chinese-latex.git"
  },
  "homepage": "https://github.com/NeekoNoNeko/hermes-chinese-latex#readme",
  "bugs": {
    "url": "https://github.com/NeekoNoNeko/hermes-chinese-latex/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "dependencies": {
    "entities": "6.0.1",
    "katex": "0.18.2",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "jsdom": "26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-rehype": "11.1.2"
  },
  "overrides": {
    "katex": "$katex"
  }
}
